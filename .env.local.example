# ==============================================================================
# Warren Portfolio - Environment Variables Configuration Template
# Copy this file to .env.local for local development
# ==============================================================================

# Supabase (Required)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Redis (Required for BullMQ price workers, background jobs & caching)
REDIS_URL=redis://localhost:6379

# InvertirOnline (IOL) API (Optional — for Argentine corporate bonds / ONs pricing)
# IOL_USERNAME=your_username
# IOL_PASSWORD=your_password

# Telegram Notifications (Optional — for real-time price & signal alerts)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Email Notifications via Resend (Optional — for transaction & signal alerts)
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=alerts@yourdomain.com
