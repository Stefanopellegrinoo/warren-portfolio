# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (optional — only needed for BullMQ price worker)
# REDIS_URL=redis://localhost:6379

# IOL (InvertirOnline) — required for ON/bond price fetching
# IOL_USERNAME=tu@email.com
# IOL_PASSWORD=tu_password

# Telegram notifications (Sprint 6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications via Resend (Sprint 6)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
